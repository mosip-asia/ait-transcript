        <mxCell id="e13l" value='&lt;font style="font-size:9px"&gt;APPROVE · REVOKE&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;INTERNAL API&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e13"><mxGeometry relative="1" as="geometry"><mxPoint x="66" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#4f5d75;strokeWidth=1;exitX=1.0000;exitY=0.6875;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="certify" target="registry"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="944" y="440"/><mxPoint x="944" y="608"/></Array></mxGeometry></mxCell>
        <mxCell id="e14l" value='&lt;font style="font-size:9px"&gt;STATUS LIST&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;RE-SIGNED EVERY ~60 S&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e14"><mxGeometry relative="1" as="geometry"><mxPoint x="76" y="-12" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#4f5d75;strokeWidth=1;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;dashed=1;dashPattern=5 4;" edge="1" parent="1" source="catalog" target="verifier"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e15l" value='&lt;font style="font-size:9px"&gt;PDF + QR&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;CARRIED BY THE STUDENT&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e15"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="-2" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#4f5d75;strokeWidth=1;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="verifier" target="registry"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e16l" value='&lt;font style="font-size:9px"&gt;KEY + STATUS&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;DID:WEB · HTTP GET&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e16"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#4f5d75;strokeWidth=1;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="sisad" target="sis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e17l" value='&lt;font style="font-size:9px"&gt;SQL READ&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e17"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="t18" value='&lt;i&gt;&lt;font face="Georgia" style="font-size:16px" color="#4f5d75"&gt;Nothing on campus is replaced.&lt;/font&gt;&lt;br&gt;&lt;font face="Georgia" style="font-size:16px" color="#7a8399"&gt;Two adapters translate; the issuer only ever asks, and only reads.&lt;/font&gt;&lt;/i&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="384" width="540" height="56" as="geometry"/></mxCell>
        <mxCell id="t19" value='&lt;font style="font-size:9px" color="#4f5d75"&gt;LEGEND&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="888" width="72" height="20" as="geometry"/></mxCell>
        <mxCell id="l20" value="" style="rounded=1;arcSize=15;html=1;fillColor=#ffffff;strokeColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="144" y="892" width="24" height="14" as="geometry"/></mxCell>
        <mxCell id="t21" value='&lt;font style="font-size:9px" color="#4f5d75"&gt;NEW COMPONENT&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="174" y="888" width="190" height="20" as="geometry"/></mxCell>
        <mxCell id="l22" value="" style="rounded=1;arcSize=15;html=1;fillColor=#e4e6e9;strokeColor=#7a8399;" vertex="1" parent="1"><mxGeometry x="300" y="892" width="24" height="14" as="geometry"/></mxCell>
        <mxCell id="t23" value='&lt;font style="font-size:9px" color="#4f5d75"&gt;EXISTING AT AIT&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="330" y="888" width="190" height="20" as="geometry"/></mxCell>
        <mxCell id="l24" value="" style="rounded=1;arcSize=15;html=1;fillColor=#e4e6e9;strokeColor=#7a8399;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="464" y="892" width="24" height="14" as="geometry"/></mxCell>
        <mxCell id="t25" value='&lt;font style="font-size:9px" color="#4f5d75"&gt;ASSUMED, NOT CONFIRMED&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="494" y="888" width="190" height="20" as="geometry"/></mxCell>
        <mxCell id="l26" value="" style="rounded=1;arcSize=15;html=1;fillColor=#fbe5da;strokeColor=#eb6c36;" vertex="1" parent="1"><mxGeometry x="668" y="892" width="24" height="14" as="geometry"/></mxCell>
        <mxCell id="t27" value='&lt;font style="font-size:9px" color="#4f5d75"&gt;HOLDS THE SIGNING KEY&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="698" y="888" width="190" height="20" as="geometry"/></mxCell>
        <mxCell id="l28" value="" style="rounded=1;arcSize=15;html=1;fillColor=#f1f1f2;strokeColor=#9a9ea9;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="868" y="892" width="24" height="14" as="geometry"/></mxCell>
        <mxCell id="t29" value='&lt;font style="font-size:9px" color="#4f5d75"&gt;DESIGN-TIME&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="898" y="888" width="190" height="20" as="geometry"/></mxCell>
        <mxCell id="l30" value="" style="line;html=1;strokeColor=#4f5d75;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="1012" y="894" width="24" height="10" as="geometry"/></mxCell>
        <mxCell id="t31" value='&lt;font style="font-size:9px" color="#4f5d75"&gt;PASSIVE: CARRIED OR LOOKED UP&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1042" y="888" width="190" height="20" as="geometry"/></mxCell>
        <mxCell id="n32" value="&lt;font style=&quot;font-size:8px&quot; color=&quot;#7a8399&quot;&gt;ON THE LINES&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#2d3142&quot;&gt;What crosses, in what standard&lt;/b&gt;&lt;ul style=&quot;margin:6px 0 0 0;padding-left:16px;font-size:11px;color:#4f5d75&quot;&gt;&lt;li&gt;&lt;b&gt;Sign-in&lt;/b&gt;: OpenID Connect authorization code flow. The adapter is the only part that touches campus passwords.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Claim&lt;/b&gt;: OpenID4VCI. The credential is a W3C Verifiable Credential (JSON-LD or SD-JWT).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Transcript data&lt;/b&gt;: one REST call per issuance, GET /students/:id/transcript, fetched and not stored.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Revocation&lt;/b&gt;: a W3C Bitstring Status List, re-signed and pushed to the public registry.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Verification&lt;/b&gt;: plain HTTP GETs for the issuer's did:web key and the status list. The issuer VM is never called.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingRight=10;spacingTop=10;fillColor=#ffffff;strokeColor=#d9dade;" vertex="1" parent="1"><mxGeometry x="48" y="932" width="400" height="300" as="geometry"/></mxCell>
        <mxCell id="n33" value="&lt;font style=&quot;font-size:8px&quot; color=&quot;#7a8399&quot;&gt;LEFT OFF THE PICTURE&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#2d3142&quot;&gt;In the proposal, not drawn here&lt;/b&gt;&lt;ul style=&quot;margin:6px 0 0 0;padding-left:16px;font-size:11px;color:#4f5d75&quot;&gt;&lt;li&gt;&lt;b&gt;Reverse proxy and certificates&lt;/b&gt; on the issuer VM: Let's Encrypt, host-based routing.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Backups&lt;/b&gt;: disk snapshots, a database dump to cloud storage, a yearly cold archive.&lt;/li&gt;&lt;li&gt;&lt;b&gt;The operational database&lt;/b&gt;: PostgreSQL on the issuer VM. Holds student ID, name, school, programme and revocation index.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Milestone 2&lt;/b&gt;: national trust framework, ThaID and other wallets, wallet-to-verifier presentation.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Counter-printed paper transcripts&lt;/b&gt;: described as a later extension.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingRight=10;spacingTop=10;fillColor=#ffffff;strokeColor=#d9dade;" vertex="1" parent="1"><mxGeometry x="464" y="932" width="384" height="300" as="geometry"/></mxCell>
        <mxCell id="n34" value="&lt;font style=&quot;font-size:8px&quot; color=&quot;#7a8399&quot;&gt;STATED AS OPEN&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#2d3142&quot;&gt;What the proposal has not settled&lt;/b&gt;&lt;ul style=&quot;margin:6px 0 0 0;padding-left:16px;font-size:11px;color:#4f5d75&quot;&gt;&lt;li&gt;The campus identity system: protocol and address are unconfirmed, LDAP is an assumption.&lt;/li&gt;&lt;li&gt;The adapter product: eSignet or another OpenID Connect bridge.&lt;/li&gt;&lt;li&gt;The SIS adapter's hostname is marked temporary.&lt;/li&gt;&lt;li&gt;The approval queue: an off-the-shelf workflow tool or a small in-house one.&lt;/li&gt;&lt;li&gt;Thailand's national governance authority does not exist yet; alignment waits for it.&lt;/li&gt;&lt;li&gt;How the issuer registers with the governance registry, and where a verifier uses it, are drawn but not specified.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingRight=10;spacingTop=10;fillColor=#ffffff;strokeColor=#d9dade;" vertex="1" parent="1"><mxGeometry x="864" y="932" width="368" height="300" as="geometry"/></mxCell>
        <mxCell id="t35" value='&lt;font style="font-size:8px" color="#7a8399"&gt;SOURCE: MOSIP-ASIA/AIT-TRANSCRIPT PR 4 · WIKI/PROJECT/PROPOSAL-ISSUER.MD · DRAWN 2026-10-05&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="48" y="1244" width="800" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
