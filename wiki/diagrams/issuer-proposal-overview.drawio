<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.17">
  <diagram id="issuer-proposal-overview" name="Overview">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="4" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1270" background="#f5f5f5" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h1" value='&lt;font style="font-size:9px" color="#4f5d75"&gt;SYSTEM OVERVIEW · AIT INSTITUTIONAL VC ISSUER · AS PROPOSED&lt;/font&gt;&lt;br&gt;&lt;font face="Georgia" style="font-size:24px" color="#2d3142"&gt;One signing engine between the campus and the outside world&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#4f5d75"&gt;Nothing on campus is replaced: two adapters translate, one virtual machine signs, and everything a verifier reads is a static public file.&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="48" y="-24" width="1184" height="104" as="geometry"/></mxCell>
        <mxCell id="z2" value='&lt;font style="font-size:8px" color="#8a8d98"&gt;AIT CAMPUS NETWORK&lt;/font&gt;' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f1f1f2;strokeColor=#d9dade;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="48" y="128" width="576" height="560" as="geometry"/></mxCell>
        <mxCell id="z3" value='&lt;font style="font-size:8px" color="#8a8d98"&gt;ISSUER VM · GOOGLE CLOUD&lt;/font&gt;' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f1f1f2;strokeColor=#d9dade;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="656" y="320" width="272" height="368" as="geometry"/></mxCell>
        <mxCell id="z4" value='&lt;font style="font-size:8px" color="#8a8d98"&gt;PUBLIC-FACING · CLOUD AND CDN&lt;/font&gt;' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f1f1f2;strokeColor=#d9dade;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="960" y="128" width="272" height="560" as="geometry"/></mxCell>
        <mxCell id="dir" value='&lt;font style="font-size:8px" color="#4f5d75"&gt;EXISTING&lt;/font&gt;&lt;font style="font-size:8px" color="#7a8399"&gt;&amp;nbsp; · &amp;nbsp;ASSUMED&lt;/font&gt;&lt;br&gt;&lt;b style="font-size:13px;color:#2d3142"&gt;Campus directory&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:9px" color="#4f5d75"&gt;LDAP or AD · not yet confirmed&lt;/font&gt;&lt;hr size="1" style="border-color:#d9dade"&gt;&lt;font style="font-size:11px" color="#4f5d75"&gt;Holds student and staff logins.&lt;br&gt;Run by ITserv. Not modified.&lt;/font&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=6;fillColor=#e4e6e9;strokeColor=#7a8399;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="64" y="160" width="240" height="128" as="geometry"/></mxCell>
        <mxCell id="oauth" value='&lt;font style="font-size:8px" color="#4f5d75"&gt;NEW&lt;/font&gt;&lt;br&gt;&lt;b style="font-size:13px;color:#2d3142"&gt;OAuth adapter&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:9px" color="#4f5d75"&gt;oauth.credentials.ait.ac.th&lt;/font&gt;&lt;hr size="1" style="border-color:#d9dade"&gt;&lt;font style="font-size:11px" color="#4f5d75"&gt;Turns a campus login into standard&lt;br&gt;OpenID Connect. eSignet or similar.&lt;/font&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="368" y="160" width="240" height="128" as="geometry"/></mxCell>
        <mxCell id="sis" value='&lt;font style="font-size:8px" color="#4f5d75"&gt;EXISTING&lt;/font&gt;&lt;br&gt;&lt;b style="font-size:13px;color:#2d3142"&gt;Student information system&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:9px" color="#4f5d75"&gt;OSA is the data owner&lt;/font&gt;&lt;hr size="1" style="border-color:#d9dade"&gt;&lt;font style="font-size:11px" color="#4f5d75"&gt;Grades, courses, degrees. Stays&lt;br&gt;the only system of record.&lt;/font&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=6;fillColor=#e4e6e9;strokeColor=#7a8399;" vertex="1" parent="1"><mxGeometry x="64" y="544" width="240" height="128" as="geometry"/></mxCell>
        <mxCell id="sisad" value='&lt;font style="font-size:8px" color="#4f5d75"&gt;NEW&lt;/font&gt;&lt;font style="font-size:8px" color="#7a8399"&gt;&amp;nbsp; · &amp;nbsp;TEMPORARY NAME&lt;/font&gt;&lt;br&gt;&lt;b style="font-size:13px;color:#2d3142"&gt;SIS adapter&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:9px" color="#4f5d75"&gt;api.credentials.ait.ac.th&lt;/font&gt;&lt;hr size="1" style="border-color:#d9dade"&gt;&lt;font style="font-size:11px" color="#4f5d75"&gt;Reads one transcript on demand.&lt;br&gt;Code and queries open to OSA.&lt;/font&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="368" y="544" width="240" height="128" as="geometry"/></mxCell>
        <mxCell id="certify" value='&lt;font style="font-size:8px" color="#eb6c36"&gt;NEW&lt;/font&gt;&lt;font style="font-size:8px" color="#7a8399"&gt;&amp;nbsp; · &amp;nbsp;INJI CERTIFY&lt;/font&gt;&lt;br&gt;&lt;b style="font-size:13px;color:#2d3142"&gt;Issuing engine&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:9px" color="#4f5d75"&gt;issuer.credentials.ait.ac.th&lt;/font&gt;&lt;hr size="1" style="border-color:#d9dade"&gt;&lt;font style="font-size:11px" color="#4f5d75"&gt;Signs every credential. Keeps a&lt;br&gt;revocation index, never grades.&lt;/font&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=6;fillColor=#fbe5da;strokeColor=#eb6c36;" vertex="1" parent="1"><mxGeometry x="672" y="352" width="240" height="128" as="geometry"/></mxCell>
        <mxCell id="portal" value='&lt;font style="font-size:8px" color="#4f5d75"&gt;NEW&lt;/font&gt;&lt;br&gt;&lt;b style="font-size:13px;color:#2d3142"&gt;Admin portal&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:9px" color="#4f5d75"&gt;portal.credentials.ait.ac.th&lt;/font&gt;&lt;hr size="1" style="border-color:#d9dade"&gt;&lt;font style="font-size:11px" color="#4f5d75"&gt;OSA officers approve requests,&lt;br&gt;search issued ones, and revoke.&lt;/font&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="672" y="544" width="240" height="128" as="geometry"/></mxCell>
        <mxCell id="catalog" value='&lt;font style="font-size:8px" color="#4f5d75"&gt;NEW&lt;/font&gt;&lt;font style="font-size:8px" color="#7a8399"&gt;&amp;nbsp; · &amp;nbsp;INJI WEB&lt;/font&gt;&lt;br&gt;&lt;b style="font-size:13px;color:#2d3142"&gt;Student catalog&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:9px" color="#4f5d75"&gt;my.credentials.ait.ac.th&lt;/font&gt;&lt;hr size="1" style="border-color:#d9dade"&gt;&lt;font style="font-size:11px" color="#4f5d75"&gt;Claim into a wallet, or download&lt;br&gt;a 90-day A4 PDF with no wallet.&lt;/font&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="976" y="160" width="240" height="128" as="geometry"/></mxCell>
        <mxCell id="verifier" value='&lt;font style="font-size:8px" color="#4f5d75"&gt;NEW&lt;/font&gt;&lt;br&gt;&lt;b style="font-size:13px;color:#2d3142"&gt;Web verifier&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:9px" color="#4f5d75"&gt;verify.credentials.ait.ac.th&lt;/font&gt;&lt;hr size="1" style="border-color:#d9dade"&gt;&lt;font style="font-size:11px" color="#4f5d75"&gt;An employer scans the QR. Checks&lt;br&gt;signature, expiry and revocation.&lt;/font&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="976" y="352" width="240" height="128" as="geometry"/></mxCell>
        <mxCell id="registry" value='&lt;font style="font-size:8px" color="#4f5d75"&gt;NEW&lt;/font&gt;&lt;br&gt;&lt;b style="font-size:13px;color:#2d3142"&gt;Public registry&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:9px" color="#4f5d75"&gt;credentials.ait.ac.th · CDN&lt;/font&gt;&lt;hr size="1" style="border-color:#d9dade"&gt;&lt;font style="font-size:11px" color="#4f5d75"&gt;Issuer key, revocation lists, PDF&lt;br&gt;templates. Static files, always on.&lt;/font&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=6;fillColor=#ebebec;strokeColor=#4f5d75;" vertex="1" parent="1"><mxGeometry x="976" y="544" width="240" height="128" as="geometry"/></mxCell>
        <mxCell id="design" value='&lt;font style="font-size:8px" color="#4f5d75"&gt;NEW&lt;/font&gt;&lt;font style="font-size:8px" color="#7a8399"&gt;&amp;nbsp; · &amp;nbsp;DESIGN-TIME, NOT RUN-TIME&lt;/font&gt;&lt;br&gt;&lt;b style="font-size:13px;color:#2d3142"&gt;Governance registry and design labs&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:9px" color="#4f5d75"&gt;trust.credentials.ait.ac.th · VC Lab · Card Display Lab&lt;/font&gt;&lt;hr size="1" style="border-color:#d9dade"&gt;&lt;font style="font-size:11px" color="#4f5d75"&gt;AIT owns the schemas and issuance policy here. VC Lab and Card Display Lab read the schemas&lt;br&gt;to design the transcript layout and wallet card, offline. Output ships by a Git commit and a restart.&lt;/font&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=6;fillColor=#f1f1f2;strokeColor=#9a9ea9;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="672" y="724" width="544" height="128" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#4f5d75;strokeWidth=1;exitX=0.7794;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="design" target="registry"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5l" value='&lt;font style="font-size:9px"&gt;TEMPLATES&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;VIA GIT + CI/CD&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e5"><mxGeometry relative="1" as="geometry"><mxPoint x="-70" y="4" as="offset"/></mxGeometry></mxCell>
