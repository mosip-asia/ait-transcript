        <mxCell id="e7l" value='&lt;font style="font-size:9px"&gt;SCHEMA LOOKUP&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;STATED IN 2.4 ONLY&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e7"><mxGeometry relative="1" as="geometry"><mxPoint x="-68" y="110" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#4f5d75;strokeWidth=1;exitX=0.0000;exitY=0.3125;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3125;entryDx=0;entryDy=0;" edge="1" parent="1" source="catalog" target="oauth"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8l" value='&lt;font style="font-size:9px"&gt;STUDENT SIGNS IN&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;OPENID CONNECT · REDIRECT&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e8"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-20" as="offset"/></mxGeometry></mxCell>
