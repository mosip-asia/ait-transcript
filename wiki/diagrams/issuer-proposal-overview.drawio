        <mxCell id="e10l" value='&lt;font style="font-size:9px"&gt;CHECKS THE TOKEN&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;OIDC · JWKS&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e10"><mxGeometry relative="1" as="geometry"><mxPoint x="72" y="-32" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#4f5d75;strokeWidth=1;exitX=0.0000;exitY=0.6875;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3125;entryDx=0;entryDy=0;" edge="1" parent="1" source="catalog" target="certify"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="944" y="248"/><mxPoint x="944" y="392"/></Array></mxGeometry></mxCell>
        <mxCell id="e11l" value='&lt;font style="font-size:9px"&gt;CLAIM&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;OPENID4VCI · AUTH CODE&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e11"><mxGeometry relative="1" as="geometry"><mxPoint x="-74" y="-32" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#4f5d75;strokeWidth=1;exitX=0.0000;exitY=0.5625;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="certify" target="sisad"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="628" y="424"/><mxPoint x="628" y="608"/></Array></mxGeometry></mxCell>
        <mxCell id="e12l" value='&lt;font style="font-size:9px"&gt;ONE TRANSCRIPT&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;REST · JSON · ON DEMAND&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e12"><mxGeometry relative="1" as="geometry"><mxPoint x="-72" y="8" as="offset"/></mxGeometry></mxCell>
