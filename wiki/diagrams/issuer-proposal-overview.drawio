        <mxCell id="e6l" value='&lt;font style="font-size:9px"&gt;REGISTRATION&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;PROTOCOL NOT STATED&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e6"><mxGeometry relative="1" as="geometry"><mxPoint x="-74" y="82" as="offset"/></mxGeometry></mxCell>
