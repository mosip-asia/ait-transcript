<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.17">
  <diagram id="issuer-proposal-itserv" name="ITserv view">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="4" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1100" background="#f5f5f5" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h1" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#4f5d75&quot;&gt;INTEGRATION VIEW FOR ITSERV · SIGN-IN AND STUDENT RECORDS&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Georgia&quot; style=&quot;font-size:24px&quot; color=&quot;#2d3142&quot;&gt;Two doors into campus systems, and what sits behind each&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#4f5d75&quot;&gt;The proposed issuer reaches ITserv's systems at exactly two points, drawn in orange: one login check against the campus directory, one read-only query against the student information system.&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="48" y="-24" width="1184" height="104" as="geometry"/></mxCell>
        <mxCell id="z2" value='&lt;font style="font-size:8px" color="#8a8d98"&gt;OUTSIDE CAMPUS · CLOUD HOSTED&lt;/font&gt;' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f1f1f2;strokeColor=#d9dade;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="32" y="128" width="256" height="512" as="geometry"/></mxCell>
        <mxCell id="z3" value='&lt;font style="font-size:8px" color="#8a8d98"&gt;NEW · PROPOSED FOR THE CAMPUS DMZ&lt;/font&gt;' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f1f1f2;strokeColor=#d9dade;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="464" y="128" width="352" height="512" as="geometry"/></mxCell>
        <mxCell id="z4" value='&lt;font style="font-size:8px" color="#8a8d98"&gt;EXISTING · RUN BY ITSERV&lt;/font&gt;' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f1f1f2;strokeColor=#d9dade;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="960" y="128" width="272" height="512" as="geometry"/></mxCell>
        <mxCell id="catalog" value='&lt;font style="font-size:8px" color="#4f5d75"&gt;NEW&lt;/font&gt;&lt;font style="font-size:8px" color="#7a8399"&gt;&amp;nbsp; · &amp;nbsp;INJI WEB&lt;/font&gt;&lt;br&gt;&lt;b style="font-size:13px;color:#2d3142"&gt;Student catalog&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:9px" color="#4f5d75"&gt;my.credentials.ait.ac.th&lt;/font&gt;&lt;hr size="1" style="border-color:#d9dade"&gt;&lt;font style="font-size:11px" color="#4f5d75"&gt;Students sign in here to claim.&lt;/font&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="48" y="160" width="224" height="112" as="geometry"/></mxCell>
        <mxCell id="portal" value='&lt;font style="font-size:8px" color="#4f5d75"&gt;NEW&lt;/font&gt;&lt;br&gt;&lt;b style="font-size:13px;color:#2d3142"&gt;Admin portal&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:9px" color="#4f5d75"&gt;portal.credentials.ait.ac.th&lt;/font&gt;&lt;hr size="1" style="border-color:#d9dade"&gt;&lt;font style="font-size:11px" color="#4f5d75"&gt;OSA officers sign in to approve.&lt;/font&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="48" y="336" width="224" height="112" as="geometry"/></mxCell>
        <mxCell id="certify" value='&lt;font style="font-size:8px" color="#4f5d75"&gt;NEW&lt;/font&gt;&lt;font style="font-size:8px" color="#7a8399"&gt;&amp;nbsp; · &amp;nbsp;INJI CERTIFY&lt;/font&gt;&lt;br&gt;&lt;b style="font-size:13px;color:#2d3142"&gt;Issuing engine&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:9px" color="#4f5d75"&gt;issuer.credentials.ait.ac.th&lt;/font&gt;&lt;hr size="1" style="border-color:#d9dade"&gt;&lt;font style="font-size:11px" color="#4f5d75"&gt;Signs. Never sees a password.&lt;/font&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="48" y="512" width="224" height="112" as="geometry"/></mxCell>
        <mxCell id="oauth" value='&lt;font style="font-size:8px" color="#4f5d75"&gt;NEW&lt;/font&gt;&lt;font style="font-size:8px" color="#7a8399"&gt;&amp;nbsp; · &amp;nbsp;ESIGNET OR SIMILAR&lt;/font&gt;&lt;br&gt;&lt;b style="font-size:13px;color:#2d3142"&gt;OAuth adapter&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:9px" color="#4f5d75"&gt;oauth.credentials.ait.ac.th · public HTTPS&lt;/font&gt;&lt;hr size="1" style="border-color:#d9dade"&gt;&lt;font style="font-size:11px" color="#4f5d75"&gt;Shows the login page: campus passwords are typed here.&lt;br&gt;Issues ID tokens; sub is the student or employee ID.&lt;br&gt;Serves /authorize /token /userinfo /jwks.json.&lt;br&gt;Owned by the integration team, hosted on campus.&lt;br&gt;Later MFA or face match would be added here only.&lt;/font&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="480" y="160" width="320" height="200" as="geometry"/></mxCell>
        <mxCell id="sisad" value='&lt;font style="font-size:8px" color="#4f5d75"&gt;NEW&lt;/font&gt;&lt;font style="font-size:8px" color="#7a8399"&gt;&amp;nbsp; · &amp;nbsp;REST · JSON&lt;/font&gt;&lt;br&gt;&lt;b style="font-size:13px;color:#2d3142"&gt;SIS adapter&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:9px" color="#4f5d75"&gt;api.credentials.ait.ac.th (temporary) · private :8082&lt;/font&gt;&lt;hr size="1" style="border-color:#d9dade"&gt;&lt;font style="font-size:11px" color="#4f5d75"&gt;One call per issuance, made at the moment of signing.&lt;br&gt;Read-only. Returns only the fields agreed with OSA.&lt;br&gt;Stores nothing. The issuer keeps no grades either.&lt;br&gt;Source code and SQL open to OSA inspection.&lt;br&gt;Co-owned by OSA and the integration team.&lt;/font&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="480" y="424" width="320" height="200" as="geometry"/></mxCell>
        <mxCell id="dir" value='&lt;font style="font-size:8px" color="#4f5d75"&gt;EXISTING&lt;/font&gt;&lt;font style="font-size:8px" color="#7a8399"&gt;&amp;nbsp; · &amp;nbsp;ASSUMED&lt;/font&gt;&lt;br&gt;&lt;b style="font-size:13px;color:#2d3142"&gt;Campus directory&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:9px" color="#4f5d75"&gt;LDAP or Active Directory?&lt;/font&gt;&lt;hr size="1" style="border-color:#d9dade"&gt;&lt;font style="font-size:8px" color="#7a8399"&gt;NEEDED FROM ITSERV&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#4f5d75"&gt;Which protocol, and which endpoint.&lt;br&gt;A service account to verify logins.&lt;br&gt;Student ID and staff ID attributes.&lt;br&gt;A way to tell OSA officers apart.&lt;br&gt;A network path from the adapter.&lt;/font&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=6;fillColor=#e4e6e9;strokeColor=#7a8399;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="976" y="160" width="240" height="200" as="geometry"/></mxCell>
        <mxCell id="sis" value='&lt;font style="font-size:8px" color="#4f5d75"&gt;EXISTING&lt;/font&gt;&lt;br&gt;&lt;b style="font-size:13px;color:#2d3142"&gt;Student information system&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:9px" color="#4f5d75"&gt;OSA is the data owner&lt;/font&gt;&lt;hr size="1" style="border-color:#d9dade"&gt;&lt;font style="font-size:8px" color="#7a8399"&gt;NEEDED FROM ITSERV&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#4f5d75"&gt;A read-only database account.&lt;br&gt;Transcript, degree and status fields.&lt;br&gt;Fee and hold status, if kept here.&lt;br&gt;A network path from the adapter.&lt;br&gt;No schema change, no writes.&lt;/font&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=6;fillColor=#e4e6e9;strokeColor=#7a8399;" vertex="1" parent="1"><mxGeometry x="976" y="424" width="240" height="200" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#4f5d75;strokeWidth=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2800;entryDx=0;entryDy=0;" edge="1" parent="1" source="catalog" target="oauth"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5l" value='&lt;font style="font-size:9px"&gt;STUDENT SIGN-IN&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;OIDC · BROWSER REDIRECT&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e5"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-20" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#4f5d75;strokeWidth=1;exitX=1.0000;exitY=0.2857;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5200;entryDx=0;entryDy=0;" edge="1" parent="1" source="portal" target="oauth"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="352" y="368"/><mxPoint x="352" y="264"/></Array></mxGeometry></mxCell>
        <mxCell id="e6l" value='&lt;font style="font-size:9px"&gt;STAFF SIGN-IN&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;SAME OIDC FLOW&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e6"><mxGeometry relative="1" as="geometry"><mxPoint x="66" y="-48" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#4f5d75;strokeWidth=1;exitX=1.0000;exitY=0.7143;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2600;entryDx=0;entryDy=0;" edge="1" parent="1" source="portal" target="sisad"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="312" y="416"/><mxPoint x="312" y="476"/></Array></mxGeometry></mxCell>
        <mxCell id="e7l" value='&lt;font style="font-size:9px"&gt;ELIGIBILITY&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;DEGREE · FEES · HOLDS&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e7"><mxGeometry relative="1" as="geometry"><mxPoint x="32" y="-20" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#4f5d75;strokeWidth=1;exitX=1.0000;exitY=0.2857;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.7600;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="certify" target="oauth"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="544"/><mxPoint x="440" y="312"/></Array></mxGeometry></mxCell>
        <mxCell id="e8l" value='&lt;font style="font-size:9px"&gt;TOKEN CHECK&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;FETCHES PUBLIC KEYS · JWKS&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e8"><mxGeometry relative="1" as="geometry"><mxPoint x="-82" y="32" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#4f5d75;strokeWidth=1;exitX=1.0000;exitY=0.7143;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.8400;entryDx=0;entryDy=0;" edge="1" parent="1" source="certify" target="sisad"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9l" value='&lt;font style="font-size:9px"&gt;TRANSCRIPT&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;GET /students/:id/transcript&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e9"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-20" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#eb6c36;strokeWidth=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="oauth" target="dir"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e10l" value='&lt;font style="font-size:9px"&gt;VERIFY LOGIN&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;LDAP BIND? · TO CONFIRM&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e10"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-20" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeColor=#eb6c36;strokeWidth=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="sisad" target="sis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e11l" value='&lt;font style="font-size:9px"&gt;READ-ONLY QUERY&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:8px"&gt;SQL · FIELDS AGREED WITH OSA&lt;/font&gt;' style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#7a8399;labelBackgroundColor=#f5f5f5;" vertex="1" connectable="0" parent="e11"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-20" as="offset"/></mxGeometry></mxCell>
        <mxCell id="t12" value='&lt;font style="font-size:9px" color="#4f5d75"&gt;LEGEND&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="64" y="664" width="72" height="20" as="geometry"/></mxCell>
        <mxCell id="l13" value="" style="rounded=1;arcSize=15;html=1;fillColor=#ffffff;strokeColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="144" y="668" width="24" height="14" as="geometry"/></mxCell>
        <mxCell id="t14" value='&lt;font style="font-size:9px" color="#4f5d75"&gt;NEW COMPONENT&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="174" y="664" width="190" height="20" as="geometry"/></mxCell>
        <mxCell id="l15" value="" style="rounded=1;arcSize=15;html=1;fillColor=#e4e6e9;strokeColor=#7a8399;" vertex="1" parent="1"><mxGeometry x="320" y="668" width="24" height="14" as="geometry"/></mxCell>
        <mxCell id="t16" value='&lt;font style="font-size:9px" color="#4f5d75"&gt;EXISTING, UNCHANGED&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="350" y="664" width="190" height="20" as="geometry"/></mxCell>
        <mxCell id="l17" value="" style="rounded=1;arcSize=15;html=1;fillColor=#e4e6e9;strokeColor=#7a8399;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="520" y="668" width="24" height="14" as="geometry"/></mxCell>
        <mxCell id="t18" value='&lt;font style="font-size:9px" color="#4f5d75"&gt;ASSUMED, NOT CONFIRMED&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="550" y="664" width="190" height="20" as="geometry"/></mxCell>
        <mxCell id="l19" value="" style="shape=flexArrow;html=1;endSize=3;endWidth=6;width=1;fillColor=#eb6c36;strokeColor=#eb6c36;" vertex="1" parent="1"><mxGeometry x="744" y="670" width="24" height="10" as="geometry"/></mxCell>
        <mxCell id="t20" value='&lt;font style="font-size:9px" color="#4f5d75"&gt;REACHES AN ITSERV SYSTEM&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="774" y="664" width="190" height="20" as="geometry"/></mxCell>
        <mxCell id="n21" value='&lt;font style="font-size:8px" color="#7a8399"&gt;ALSO ASKED OF ITSERV&lt;/font&gt;&lt;br&gt;&lt;b style="font-size:13px;color:#2d3142"&gt;Hosting and network, not on the lines&lt;/b&gt;&lt;ul style="margin:6px 0 0 0;padding-left:16px;font-size:11px;color:#4f5d75"&gt;&lt;li&gt;&lt;b&gt;DNS&lt;/b&gt;: a credentials.ait.ac.th zone with eight names under it; two of them (oauth. and api.) point at campus.&lt;/li&gt;&lt;li&gt;&lt;b&gt;A place to run the two adapters&lt;/b&gt;: the proposal lists them under campus IT and the DMZ.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Inbound HTTPS&lt;/b&gt; from the internet to the OAuth adapter, with a public certificate.&lt;/li&gt;&lt;li&gt;&lt;b&gt;A private route&lt;/b&gt; from the cloud-hosted issuing engine to the SIS adapter on port 8082. The proposal does not say how: VPN, allow-list or otherwise.&lt;/li&gt;&lt;/ul&gt;' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingRight=10;spacingTop=10;fillColor=#ffffff;strokeColor=#d9dade;" vertex="1" parent="1"><mxGeometry x="32" y="712" width="416" height="280" as="geometry"/></mxCell>
        <mxCell id="n22" value="&lt;font style=&quot;font-size:8px&quot; color=&quot;#7a8399&quot;&gt;WHAT DOES NOT CHANGE&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#2d3142&quot;&gt;Limits the proposal sets on itself&lt;/b&gt;&lt;ul style=&quot;margin:6px 0 0 0;padding-left:16px;font-size:11px;color:#4f5d75&quot;&gt;&lt;li&gt;No change to the directory or the SIS; no second system of record.&lt;/li&gt;&lt;li&gt;The issuer's database keeps student ID, name, school and programme for search and revocation. No grades, courses or GPA.&lt;/li&gt;&lt;li&gt;Issuance is on demand, one student at a time. Batch issuance is described as a later option.&lt;/li&gt;&lt;li&gt;Stronger identity checks (MFA, biometrics) are explicitly not an ITserv responsibility.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingRight=10;spacingTop=10;fillColor=#ffffff;strokeColor=#d9dade;" vertex="1" parent="1"><mxGeometry x="464" y="712" width="384" height="280" as="geometry"/></mxCell>
        <mxCell id="n23" value="&lt;font style=&quot;font-size:8px&quot; color=&quot;#7a8399&quot;&gt;TO SETTLE WITH ITSERV&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px;color:#2d3142&quot;&gt;Open or unstated in the proposal&lt;/b&gt;&lt;ul style=&quot;margin:6px 0 0 0;padding-left:16px;font-size:11px;color:#4f5d75&quot;&gt;&lt;li&gt;The directory's protocol and address: the proposal calls LDAP an assumption.&lt;/li&gt;&lt;li&gt;Whether a login page outside the central IdP may collect campus passwords.&lt;/li&gt;&lt;li&gt;Where fee and hold status comes from; the eligibility check needs it and no source is named.&lt;/li&gt;&lt;li&gt;Who operates and patches the adapters day to day once they sit on campus.&lt;/li&gt;&lt;li&gt;The 'needed from ITserv' lists are read out of the proposal; it does not itemise them.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingRight=10;spacingTop=10;fillColor=#ffffff;strokeColor=#d9dade;" vertex="1" parent="1"><mxGeometry x="864" y="712" width="368" height="280" as="geometry"/></mxCell>
        <mxCell id="t24" value='&lt;font style="font-size:8px" color="#7a8399"&gt;SOURCE: MOSIP-ASIA/AIT-TRANSCRIPT PR 4 · WIKI/PROJECT/PROPOSAL-ISSUER.MD · DRAWN 2026-10-05&lt;/font&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="32" y="1004" width="800" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
