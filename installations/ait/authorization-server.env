# The Authorization Server the AIT installation trusts (configuration-contract.md → Authorization Server). Each value
# below is the stand-in realm `inji`'s, used locally and on CI. An environment points the installation at another
# server by setting the same variable in vc-stack/.env (on the VM, app.env), which wins over the value here. Compose
# reads this file as an env_file of certify and demo-app; bootstrap.sh and smoke.sh read it back through Compose.
# The issuer: every access token's iss, Certify's issuer URI and its metadata's authorization_servers.
AUTH_SERVER_ISSUER=${AUTH_SERVER_ISSUER:-${KEYCLOAK_DOCKER_AUTH_SERVER:-http://keycloak:8080}/realms/inji}
# Where Certify fetches the issuer's signing keys.
AUTH_SERVER_JWKS_URL=${AUTH_SERVER_JWKS_URL:-${KEYCLOAK_INTERNAL_BASE_URL:-http://host.docker.internal:9080}/realms/inji/protocol/openid-connect/certs}
# The token endpoint as the Docker network reaches it: Mimoto's authorization_audience and proxy_token_endpoint, and
# the smoke's token request (vc-stack/issue_and_verify.py).
AUTH_SERVER_TOKEN_ENDPOINT=${AUTH_SERVER_TOKEN_ENDPOINT:-${KEYCLOAK_DOCKER_AUTH_SERVER:-http://keycloak:8080}/realms/inji/protocol/openid-connect/token}
# The issuer as a browser or a phone reaches it: Inji Web's login page, the Portal's sign-out link, the phone's metadata.
AUTH_SERVER_PUBLIC_URL=${AUTH_SERVER_PUBLIC_URL:-${KEYCLOAK_PUBLIC_BASE_URL:-http://localhost:9080}/realms/inji}
# The wallet client: Mimoto's client_id, and an audience Certify accepts.
AUTH_SERVER_WALLET_CLIENT_ID=${AUTH_SERVER_WALLET_CLIENT_ID:-wallet-demo}
