{
  "realm": "hackathon",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": true,
  "accessTokenLifespan": 900,
  "browserFlow": "browser-no-sso",
  "authenticationFlows": [
    {
      "alias": "browser-no-sso",
      "description": "Browser flow minus the Cookie/SSO step, so each per-degree Keycloak identity always re-prompts instead of silently reusing a session.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "DISABLED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "developer_passport_vc_ldp",
      "description": "OpenID4VCI scope for the hackathon Developer Passport credential",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-certify",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "http://certify-nginx/v1/certify/issuance/credential",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "achievement_certificate_vc_ldp",
      "description": "OpenID4VCI scope for the hackathon Achievement Certificate credential",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-certify",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "http://certify-nginx/v1/certify/issuance/credential",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
