{
  "credential_config_key_id": "developer-passport",
  "status": "active",
  "scope": "developer_passport_vc_ldp",
  "credential_type": "DeveloperPassportCredential,VerifiableCredential",
  "credential_format": "ldp_vc",
  "context": [
    "http://host.docker.internal:9098/contexts/developer-passport/v1.json",
    "https://www.w3.org/ns/credentials/v2"
  ],
  "did_url": "did:key:z6MkpPLACEHOLDERreplaceMeViaBootstrapDidRefreshScript1",
  "key_manager_app_id": "CERTIFY_VC_SIGN_ED25519",
  "key_manager_ref_id": "ED25519_SIGN",
  "signature_algo": "EdDSA",
  "signature_crypto_suite": "Ed25519Signature2020",
  "display": [
    {
      "name": "AIT Developer Passport",
      "locale": "en",
      "logo": {
        "url": "https://ait.ac.th/wp-content/uploads/2024/09/AIT_globe.png",
        "alt_text": "AIT Logo"
      },
      "background_color": "#0f766e",
      "text_color": "#FFFFFF",
      "background_image": {
        "uri": "https://ait.ac.th/wp-content/uploads/2024/09/AIT_globe.png"
      }
    }
  ],
  "display_order": [
    "teamName",
    "teamId",
    "oidcClientId",
    "authEndpoint",
    "issuerEndpoint",
    "verifierEndpoint"
  ],
  "cryptographic_binding_methods_supported": [
    "did:jwk"
  ],
  "credential_signing_alg_values_supported": [
    "Ed25519Signature2020"
  ],
  "proof_types_supported": {
    "jwt": {
      "proof_signing_alg_values_supported": [
        "RS256",
        "ES256"
      ]
    }
  },
  "credential_status_purpose": [
    "revocation"
  ],
  "qr_settings": [
    {
      "Team": "${teamName}"
    }
  ],
  "qr_signature_algo": "EdDSA",
  "credential_subject": {
    "teamId": {
      "display": [
        {
          "name": "Team ID",
          "locale": "en"
        }
      ]
    },
    "teamName": {
      "display": [
        {
          "name": "Team",
          "locale": "en"
        }
      ]
    },
    "oidcClientId": {
      "display": [
        {
          "name": "OIDC Client ID",
          "locale": "en"
        }
      ]
    },
    "authEndpoint": {
      "display": [
        {
          "name": "Sign-in Endpoint",
          "locale": "en"
        }
      ]
    },
    "issuerEndpoint": {
      "display": [
        {
          "name": "Issuer Endpoint",
          "locale": "en"
        }
      ]
    },
    "verifierEndpoint": {
      "display": [
        {
          "name": "Verifier Endpoint",
          "locale": "en"
        }
      ]
    }
  },
  "vc_template": {
    "@context": [
      "https://www.w3.org/ns/credentials/v2",
      "http://host.docker.internal:9098/contexts/developer-passport/v1.json",
      "https://w3id.org/security/suites/ed25519-2020/v1"
    ],
    "issuer": "${_issuer}",
    "type": [
      "VerifiableCredential",
      "DeveloperPassportCredential"
    ],
    "validFrom": "${validFrom}",
    "validUntil": "${validUntil}",
    "credentialStatus": {
      "id": "${credentialStatus.id}",
      "type": "${credentialStatus.type}",
      "statusPurpose": "${credentialStatus.statusPurpose}",
      "statusListIndex": "${credentialStatus.statusPurpose}",
      "statusListCredential": "${credentialStatus.statusListCredential}"
    },
    "credentialSubject": {
      "id": "${_holderId}",
      "teamId": "${teamId}",
      "teamName": "${teamName}",
      "oidcClientId": "${oidcClientId}",
      "authEndpoint": "${authEndpoint}",
      "issuerEndpoint": "${issuerEndpoint}",
      "verifierEndpoint": "${verifierEndpoint}"
    }
  }
}