{
  "credential_config_key_id": "achievement-certificate",
  "status": "active",
  "scope": "achievement_certificate_vc_ldp",
  "credential_type": "AchievementCertificateCredential,VerifiableCredential",
  "credential_format": "ldp_vc",
  "context": [
    "http://host.docker.internal:9098/contexts/achievement/v1.json",
    "https://www.w3.org/ns/credentials/v2"
  ],
  "did_url": "did:key:z6MkpPLACEHOLDERreplaceMeViaBootstrapDidRefreshScript1",
  "key_manager_app_id": "CERTIFY_VC_SIGN_ED25519",
