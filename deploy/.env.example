# ==============================================================================
# Inji Certify Platform - Deployment Environment Configuration
# ==============================================================================
# Usage:
#   cp .env.example .env
#   docker compose up -d
# ==============================================================================

# 1. Image Tags (Pre-built images from registry)
CERTIFY_IMAGE=ghcr.io/mosip-asia/ait-certify:latest
GATEWAY_IMAGE=ghcr.io/mosip-asia/ait-gateway:latest
TEMPLATE_SYNC_IMAGE=ghcr.io/mosip-asia/certify-template-sync:latest

# 2. Installation Profile (Tenancy / Domain)
INSTALLATION=ait

# 3. Public Base URL & Ingress
CERTIFY_PUBLIC_BASE_URL=http://localhost:9091

# 4. Cryptographic Identity (DID)
CERTIFY_DID=did:key:z6MkpPLACEHOLDERreplaceMeViaBootstrapDidRefreshScript1

# 5. Upstream Data Source (Adapter / SIS API)
CERTIFY_RECORD_URL=http://adapter:8000/student/{sub}/transcript

# 6. Approval Gate (Policy Checklist)
MOSIP_CERTIFY_GATEWAY_ENABLED=true
MOSIP_CERTIFY_GATEWAY_URL=http://gateway:8000

# 7. Authorization Server (OAuth2 / OIDC Token Verification)
# Replace <REALM_NAME> with your target realm (e.g. 'inji' or 'hackathon')
AUTH_SERVER_ISSUER=http://keycloak:8080/realms/<REALM_NAME>
AUTH_SERVER_JWKS_URL=http://host.docker.internal:9080/realms/<REALM_NAME>/protocol/openid-connect/certs
AUTH_SERVER_PUBLIC_URL=http://localhost:9080/realms/<REALM_NAME>
AUTH_SERVER_WALLET_CLIENT_ID=wallet-demo

# 8. Internal Database
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
