# The Gateway's settings for the AIT installation (gateway/main.py, Settings), read through the gateway
# service's env_file in compose.demo.yaml.
GATEWAY_ENABLED_SCOPES=ait_transcript_vc_ldp
# The student's eligibility, `{sub}` filled in: the mock Adapter's by default, since the SIS Adapter serves none yet;
# an environment sets GATEWAY_ELIGIBILITY_URL in .env (on the VM,
# app.env), which wins over this value, as in authorization-server.env.
GATEWAY_ELIGIBILITY_URL=${GATEWAY_ELIGIBILITY_URL:-http://adapter:8000/student/{sub}/eligibility}
# TEST-ONLY development value, committed so local runs and CI work. A real deployment sets its own secret,
# and the plugin's mosip.certify.gateway.auth-token must equal it.
GATEWAY_AUTH_TOKEN=dev-only-ait-gateway-token
