<?xml version="1.0" encoding="UTF-8"?>
<!-- The Certify data-provider plugin (contracts.md section 2a): one generic jar, mounted as a single file into
     Certify's additional_jars/. Everything it uses at runtime is already inside Certify, so every dependency is
     provided and nothing is shaded. Build: mvn -q package (run-demo.sh runs it in maven:3.9-eclipse-temurin-21). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>asia.mosip.issuer</groupId>
    <artifactId>gateway-data-provider-plugin</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- The SPI, on Maven Central under io.inji.certify (the Java package is io.mosip.certify). Its parent POM pulls Spring Boot starters and a jsonld library from a third-party repository;
             none of them is needed to compile against the two types used here. -->
        <dependency>
            <groupId>io.inji.certify</groupId>
            <artifactId>certify-integration-api</artifactId>
            <version>0.14.0</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- The versions Certify 0.14.0 ships (Spring Boot 3.2.3, org.json pinned by certify-parent). -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20241224</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>3.2.3</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.12</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>gateway-data-provider-plugin</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
