# ==============================================================================
# AIT Multi-Credential Verifiable Credential Platform
# Root Developer Environment Configuration
# ==============================================================================
# Copy to .env:
#   cp .env.example .env
#   docker compose up -d --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Compose Configuration & Development Mode
# ------------------------------------------------------------------------------
# Standard Mode: builds and runs container images from src/
COMPOSE_FILE=compose.yaml
#
# Hot-Reload Mode (Loop 3): merges compose.dev.yaml to mount locally compiled JAR
# COMPOSE_FILE=compose.yaml:compose.dev.yaml

# ------------------------------------------------------------------------------
# 1. Multi-Tenant Installation Profile
# ------------------------------------------------------------------------------
# Name of active installation (e.g. ait, hackathon)
INSTALLATION=ait

# ------------------------------------------------------------------------------
# 2. Public Base URL & Ingress
# ------------------------------------------------------------------------------
CERTIFY_PUBLIC_BASE_URL=http://localhost:9091

# ------------------------------------------------------------------------------
# 3. Cryptographic Identity (DID)
# ------------------------------------------------------------------------------
CERTIFY_DID=did:key:z6MkpPLACEHOLDERreplaceMeViaBootstrapDidRefreshScript1

# ------------------------------------------------------------------------------
# 4. Upstream Data Source (Adapter / SIS API)
# ------------------------------------------------------------------------------
CERTIFY_RECORD_URL=http://adapter:8000/student/{sub}/transcript

# ------------------------------------------------------------------------------
# 5. Approval Gate (Policy Checklist)
# ------------------------------------------------------------------------------
MOSIP_CERTIFY_GATEWAY_ENABLED=true
MOSIP_CERTIFY_GATEWAY_URL=http://gateway:8000

# ------------------------------------------------------------------------------
# 6. Authorization Server (OAuth2 / OIDC Token Verification)
# ------------------------------------------------------------------------------
# Replace <REALM_NAME> with your target realm (e.g. 'inji' or 'hackathon')
AUTH_SERVER_ISSUER=http://keycloak:8080/realms/<REALM_NAME>
AUTH_SERVER_JWKS_URL=http://host.docker.internal:9080/realms/<REALM_NAME>/protocol/openid-connect/certs
AUTH_SERVER_PUBLIC_URL=http://localhost:9080/realms/<REALM_NAME>
AUTH_SERVER_WALLET_CLIENT_ID=wallet-demo

# ------------------------------------------------------------------------------
# 7. Internal Database (Certify Ledger & Keystore)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
