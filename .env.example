# ==============================================================================
# AIT Multi-Credential Verifiable Credential Platform
# Root Developer Environment Configuration
# ==============================================================================
# Copy to .env:
#   cp .env.example .env
#   docker compose up -d --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Compose Configuration & Development Mode
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=ait-issuer
COMPOSE_FILE=compose.yaml
INSTALLATION=ait
#
# Hot-Reload Mode (Loop 3): merges compose.dev.yaml to mount locally compiled JAR
# COMPOSE_FILE=compose.yaml:compose.dev.yaml

# ------------------------------------------------------------------------------
# 1. Public Base URL & Ingress
# ------------------------------------------------------------------------------
CERTIFY_PUBLIC_BASE_URL=http://localhost:9091

# ------------------------------------------------------------------------------
# 2. Cryptographic Identity (DID)
# ------------------------------------------------------------------------------
CERTIFY_DID=did:key:z6MkpPLACEHOLDERreplaceMeViaBootstrapDidRefreshScript1

# ------------------------------------------------------------------------------
# 3. Upstream Data Source (Adapter / SIS API)
# ------------------------------------------------------------------------------
# Campus SIS adapter via NetBird VPN (resolves dynamically via NetBird FQDN):
CERTIFY_RECORD_URL=http://ait-itserv-dev-vm.netbird.selfhosted:8000/student/{sub}/transcript
# UAT: http://ait-itserv-uat-vm.netbird.selfhosted:8000/student/{sub}/transcript

# ------------------------------------------------------------------------------
# 4. Approval Gate (Policy Checklist)
# ------------------------------------------------------------------------------
MOSIP_CERTIFY_GATEWAY_ENABLED=false
MOSIP_CERTIFY_GATEWAY_URL=NO GATEWAY

# ------------------------------------------------------------------------------
# 5. Authorization Server (OAuth2 / OIDC Token Verification)
# ------------------------------------------------------------------------------
# Point to Certify JWKS for standalone/pre-authorized issuance, or Keycloak/campus OAuth:
AUTH_SERVER_JWKS_URL=http://certify:8090/v1/certify/.well-known/jwks.json
# AUTH_SERVER_ISSUER=https://oauth-dev.ait-itserv.dpi.ait.ac.th/realms/ait-dev
# AUTH_SERVER_TOKEN_ENDPOINT=https://oauth-dev.ait-itserv.dpi.ait.ac.th/realms/ait-dev/protocol/openid-connect/token
# AUTH_SERVER_PUBLIC_URL=https://oauth-dev.ait-itserv.dpi.ait.ac.th/realms/ait-dev
# AUTH_SERVER_WALLET_CLIENT_ID=wallet-demo

# ------------------------------------------------------------------------------
# 6. Internal Database (Certify Ledger & Keystore)
# ------------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
