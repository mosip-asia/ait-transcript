# ==============================================================================
# Inji Certify (Issuer) - Standalone Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the standalone Issuer:
#   cp .env.example .env
#   docker compose up -d
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Multi-Tenant Installation Profile
# ------------------------------------------------------------------------------
# Name of the active installation directory under installations/ (e.g., ait, hackathon).
# Determines which certify_seed.sql and certify-installation.properties are loaded.
INSTALLATION=ait

# ------------------------------------------------------------------------------
# 2. Public Base URL & Ingress
# ------------------------------------------------------------------------------
# Public base URL of Inji Certify as seen by external clients (wallets / verifiers).
# In production, set to your public HTTPS domain (e.g. https://issuer.university.edu).
CERTIFY_PUBLIC_BASE_URL=http://localhost:9091

# ------------------------------------------------------------------------------
# 3. Cryptographic Identity (DID)
# ------------------------------------------------------------------------------
# Certify's signing DID (e.g., did:key:z6Mkp...).
# On a fresh deployment, after the database is seeded and Certify initializes its
# keystore, run: ./vc-stack/bootstrap.sh --did-refresh to populate the live DID.
CERTIFY_DID=did:key:z6MkpPLACEHOLDERreplaceMeViaBootstrapDidRefreshScript1

# ------------------------------------------------------------------------------
# 4. Upstream Data Source (Adapter / SIS API)
# ------------------------------------------------------------------------------
# URL where Certify's DataProviderPlugin fetches student transcript / credential data.
# The placeholder {sub} is dynamically replaced with the authenticated subject ID.
CERTIFY_RECORD_URL=http://adapter:8000/student/{sub}/transcript

# ------------------------------------------------------------------------------
# 5. Approval Gate (Optional Policy Checklist)
# ------------------------------------------------------------------------------
# Set to 'true' to evaluate checklist rules (no holds, degree conferred, zero balance)
# before issuing a credential. Set to 'false' and MOSIP_CERTIFY_GATEWAY_URL='NO GATEWAY'
# to bypass the gate and issue directly from the data source.
MOSIP_CERTIFY_GATEWAY_ENABLED=true
MOSIP_CERTIFY_GATEWAY_URL=http://gateway:8000

# ------------------------------------------------------------------------------
# 6. Authorization Server (OAuth2 / OIDC Token Verification)
# ------------------------------------------------------------------------------
# Settings for verifying the Bearer access token presented by holder wallets.
# Must match the token's 'iss' claim and provide the JWKS endpoint for signature checks.
AUTH_SERVER_ISSUER=http://keycloak:8080/realms/inji
AUTH_SERVER_JWKS_URL=http://host.docker.internal:9080/realms/inji/protocol/openid-connect/certs
AUTH_SERVER_PUBLIC_URL=http://localhost:9080/realms/inji
AUTH_SERVER_WALLET_CLIENT_ID=wallet-demo

# ------------------------------------------------------------------------------
# 7. Internal Database (Certify Ledger & Keystore)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
