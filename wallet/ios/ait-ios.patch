diff --git a/ios/Inji/SceneDelegate.h b/ios/Inji/SceneDelegate.h
new file mode 100644
index 0000000..83261c9
--- /dev/null
+++ b/ios/Inji/SceneDelegate.h
@@ -0,0 +1,10 @@
+#import <UIKit/UIKit.h>
+
+// iOS 27 aborts apps built with its SDK that have not adopted the UIScene lifecycle.
+// React Native 0.74's RCTAppDelegate still creates the window itself, so this only hands
+// that window to the scene and forwards the URLs/user activities that now arrive on the scene.
+@interface SceneDelegate : UIResponder <UIWindowSceneDelegate>
+
+@property (strong, nonatomic) UIWindow *window;
+
+@end
diff --git a/ios/Inji/SceneDelegate.mm b/ios/Inji/SceneDelegate.mm
new file mode 100644
index 0000000..8e5cd56
--- /dev/null
+++ b/ios/Inji/SceneDelegate.mm
@@ -0,0 +1,44 @@
+#import "SceneDelegate.h"
+#import "AppDelegate.h"
+
+@implementation SceneDelegate
+
+- (AppDelegate *)appDelegate
+{
+  return (AppDelegate *)UIApplication.sharedApplication.delegate;
+}
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)connectionOptions
+{
+  if (![scene isKindOfClass:[UIWindowScene class]]) {
+    return;
+  }
+  // Created in -[AppDelegate application:didFinishLaunchingWithOptions:] by RCTAppDelegate.
+  UIWindow *window = [self appDelegate].window;
+  window.windowScene = (UIWindowScene *)scene;
+  self.window = window;
+  [window makeKeyAndVisible];
+
+  // Launch URLs and activities are delivered here, not in launchOptions, once scenes are adopted.
+  UIApplication *application = UIApplication.sharedApplication;
+  for (UIOpenURLContext *context in connectionOptions.URLContexts) {
+    [[self appDelegate] application:application openURL:context.URL options:@{}];
+  }
+  for (NSUserActivity *activity in connectionOptions.userActivities) {
+    [[self appDelegate] application:application continueUserActivity:activity restorationHandler:^(NSArray<id<UIUserActivityRestoring>> *_Nullable) {}];
+  }
+}
+
+- (void)scene:(UIScene *)scene openURLContexts:(NSSet<UIOpenURLContext *> *)URLContexts
+{
+  for (UIOpenURLContext *context in URLContexts) {
+    [[self appDelegate] application:UIApplication.sharedApplication openURL:context.URL options:@{}];
+  }
+}
+
+- (void)scene:(UIScene *)scene continueUserActivity:(NSUserActivity *)userActivity
+{
+  [[self appDelegate] application:UIApplication.sharedApplication continueUserActivity:userActivity restorationHandler:^(NSArray<id<UIUserActivityRestoring>> *_Nullable) {}];
+}
+
+@end
